import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet, TextInput, ScrollView, Alert, Modal } from 'react-native';

// Componente principal
const DrogariaCesar = () => {
  const [currentScreen, setCurrentScreen] = useState('login');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [name, setName] = useState('');
  const [carrinho, setCarrinho] = useState([]);
  const [showEasterEgg, setShowEasterEgg] = useState(false);

  // Produtos disponíveis
  const produtos = [
    { id: 1, nome: 'Paracetamol', preco: 'R$ 12,90' },
    { id: 2, nome: 'Dipirona', preco: 'R$ 8,50' },
    { id: 3, nome: 'Ibuprofeno', preco: 'R$ 15,75' },
    { id: 4, nome: 'Omeprazol', preco: 'R$ 22,30' },
    { id: 5, nome: 'Amoxilina', preco: 'R$ 18,90' },
    { id: 6, nome: 'Bandagem', preco: 'R$ 5,90' },
    { id: 7, nome: 'Álcool em Gel', preco: 'R$ 9,90' },
    { id: 8, nome: 'Termômetro', preco: 'R$ 25,00' },
  ];

  // Funções do carrinho
  const adicionarAoCarrinho = (produto) => {
    setCarrinho([...carrinho, produto]);
    Alert.alert('✅ Adicionado', `${produto.nome} foi adicionado ao carrinho!`);
  };

  const calcularTotal = () => {
    return carrinho.reduce((total, item) => {
      const preco = parseFloat(item.preco.replace('R$ ', '').replace(',', '.'));
      return total + preco;
    }, 0).toFixed(2);
  };

  const limparCarrinho = () => {
    setCarrinho([]);
    Alert.alert('🛒 Carrinho limpo!', 'Todos os itens foram removidos.');
  };

  const finalizarCompra = () => {
    Alert.alert('🎉 Compra finalizada!', `Obrigado por comprar na Drogaria Cesar!\nTotal: R$ ${calcularTotal()}`);
    setCarrinho([]);
    setCurrentScreen('produtos');
  };

  // Funções de autenticação
  const handleLogin = () => {
    if (email && password) {
      setCurrentScreen('produtos');
    } else {
      Alert.alert('⚠️ Atenção', 'Preencha email e senha para continuar!');
    }
  };

  const handleRegister = () => {
    if (name && email && password) {
      Alert.alert('✅ Sucesso', 'Cadastro realizado com sucesso!');
      setCurrentScreen('produtos');
    } else {
      Alert.alert('⚠️ Atenção', 'Preencha todos os campos para cadastrar!');
    }
  };

  // Easter Egg secreto!
  const revelarEasterEgg = () => {
    setShowEasterEgg(true);
    setTimeout(() => setShowEasterEgg(false), 2000);
  };

  // Renderizar tela atual
  const renderScreen = () => {
    switch (currentScreen) {
      case 'login':
        return <LoginScreen />;
      case 'register':
        return <RegisterScreen />;
      case 'produtos':
        return <ProdutosScreen />;
      case 'carrinho':
        return <CarrinhoScreen />;
      default:
        return null;
    }
  };

  // Componentes de cada tela
  const LoginScreen = () => (
    <View style={styles.screenContainer}>
      <TouchableOpacity onPress={revelarEasterEgg}>
        <View style={styles.logoCircle}>
          <Text style={styles.logoText1}>DROGARIA</Text>
          <Text style={styles.logoText2}>CESAR</Text>
        </View>
      </TouchableOpacity>

      <TextInput
        style={styles.input}
        placeholder="Email"
        placeholderTextColor="#999"
        value={email}
        onChangeText={setEmail}
        keyboardType="email-address"
      />

      <TextInput
        style={styles.input}
        placeholder="Senha"
        placeholderTextColor="#999"
        value={password}
        onChangeText={setPassword}
        secureTextEntry
      />

      <TouchableOpacity style={styles.button} onPress={handleLogin}>
        <Text style={styles.buttonText}>ENTRAR</Text>
      </TouchableOpacity>

      <Text style={styles.linkText}>
        Não tem uma conta?{' '}
        <Text style={styles.link} onPress={() => setCurrentScreen('register')}>
          Criar conta
        </Text>
      </Text>
    </View>
  );

  const RegisterScreen = () => (
    <View style={styles.screenContainer}>
      <TouchableOpacity onPress={revelarEasterEgg}>
        <View style={styles.logoCircle}>
          <Text style={styles.logoText1}>DROGARIA</Text>
          <Text style={styles.logoText2}>CESAR</Text>
        </View>
      </TouchableOpacity>

      <TextInput
        style={styles.input}
        placeholder="Nome completo"
        placeholderTextColor="#999"
        value={name}
        onChangeText={setName}
      />

      <TextInput
        style={styles.input}
        placeholder="Email"
        placeholderTextColor="#999"
        value={email}
        onChangeText={setEmail}
        keyboardType="email-address"
      />

      <TextInput
        style={styles.input}
        placeholder="Senha"
        placeholderTextColor="#999"
        value={password}
        onChangeText={setPassword}
        secureTextEntry
      />

      <TouchableOpacity style={styles.button} onPress={handleRegister}>
        <Text style={styles.buttonText}>CADASTRAR</Text>
      </TouchableOpacity>

      <Text style={styles.linkText}>
        Já tem uma conta?{' '}
        <Text style={styles.link} onPress={() => setCurrentScreen('login')}>
          Fazer login
        </Text>
      </Text>
    </View>
  );

  const ProdutosScreen = () => (
    <View style={styles.screenContainer}>
      <View style={styles.header}>
        <Text style={styles.title}>PRODUTOS</Text>
        <TouchableOpacity style={styles.carrinhoButton} onPress={() => setCurrentScreen('carrinho')}>
          <Text style={styles.carrinhoText}>CARRINHO ({carrinho.length})</Text>
        </TouchableOpacity>
      </View>
      
      <ScrollView style={styles.scrollContainer}>
        {produtos.map(produto => (
          <TouchableOpacity 
            key={produto.id} 
            style={styles.produtoCard}
            onPress={() => adicionarAoCarrinho(produto)}>
            <View style={styles.produtoInfo}>
              <Text style={styles.produtoNome}>{produto.nome}</Text>
              <Text style={styles.produtoPreco}>{produto.preco}</Text>
            </View>
            <Text style={styles.addButton}>+</Text>
          </TouchableOpacity>
        ))}
      </ScrollView>

      <TouchableOpacity style={styles.smallButton} onPress={() => setCurrentScreen('login')}>
        <Text style={styles.buttonText}>SAIR</Text>
      </TouchableOpacity>
    </View>
  );

  const CarrinhoScreen = () => (
    <View style={styles.screenContainer}>
      <Text style={styles.title}>CARRINHO</Text>
      
      {carrinho.length === 0 ? (
        <View style={styles.emptyContainer}>
          <Text style={styles.emptyText}>🛒 Carrinho vazio</Text>
        </View>
      ) : (
        <>
          <ScrollView style={styles.scrollContainer}>
            {carrinho.map((item, index) => (
              <View key={index} style={styles.carrinhoItem}>
                <View style={styles.carrinhoInfo}>
                  <Text style={styles.produtoNome}>{item.nome}</Text>
                  <Text style={styles.produtoPreco}>{item.preco}</Text>
                </View>
                <TouchableOpacity 
                  style={styles.deleteButton}
                  onPress={() => {
                    const novoCarrinho = [...carrinho];
                    novoCarrinho.splice(index, 1);
                    setCarrinho(novoCarrinho);
                  }}>
                  <Text style={styles.deleteText}>X</Text>
                </TouchableOpacity>
              </View>
            ))}
          </ScrollView>

          <View style={styles.totalContainer}>
            <Text style={styles.totalText}>TOTAL: R$ {calcularTotal()}</Text>
          </View>

          <TouchableOpacity style={styles.button} onPress={finalizarCompra}>
            <Text style={styles.buttonText}>FINALIZAR COMPRA</Text>
          </TouchableOpacity>

          <TouchableOpacity style={styles.smallButton} onPress={limparCarrinho}>
            <Text style={styles.buttonText}>LIMPAR CARRINHO</Text>
          </TouchableOpacity>
        </>
      )}

      <TouchableOpacity style={styles.smallButton} onPress={() => setCurrentScreen('produtos')}>
        <Text style={styles.buttonText}>VOLTAR</Text>
      </TouchableOpacity>
    </View>
  );

  return (
    <View style={styles.container}>
      {renderScreen()}
      
      {/* Easter Egg Modal */}
      <Modal visible={showEasterEgg} transparent animationType="fade">
        <View style={styles.modalContainer}>
          <View style={styles.easterEggCard}>
            <Text style={styles.easterEggText}>
              DROGARIA CESAR{"\n"}
              O IMPÉRIO DOS REMÉDIOS
            </Text>
          </View>
        </View>
      </Modal>
    </View>
  );
};

